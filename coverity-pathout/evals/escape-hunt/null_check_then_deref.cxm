// Path-INSENSITIVE candidate finder for the shape behind an escaped FORWARD_NULL:
// a pointer is null-tested somewhere in the function, and dereferenced at a
// place that no test of that pointer guards. No feasibility reasoning, no
// ordering (CodeXM's sourceloc has no fields), no reassignment tracking:
// every such pair is reported. Meant to run over a whole idir and be filtered
// to PATHOUT functions afterwards; the survivors are read, then fuzzed.
//
// "Guarded" is structural: the dereference sits inside an if statement whose
// condition tests the pointer (either branch -- the checker does not know
// which branch is the safe one), inside a ternary whose condition tests it,
// or on the right of a `p && ...` / `!p || ...`. Anything else is a
// candidate: the escaped shape (guard closes one statement too early) and
// the reverse shape (dereference before the test) both land here.
include `C/C++`;

// A variable's identity: the mangled name when the front end has one, else
// the identifier. (`.variable` is a symbol record, not a node, so it cannot
// be compared directly.)
function varKey(r : astnode) : string? ->
    if r matches variableReference as v then (v.mangledName ?? v.identifier) else null endif;

// After casts, is e a reference to the variable whose key is sym -- or an
// assignment to it, so that `while ((p = f()) != NULL)` and `if ((p = f()))`
// count as tests of p?
function refsVar(e : expression, sym : string) : bool ->
       (stripCasts(e) matches variableReference as r && varKey(r) == sym)
    || (stripCasts(e) matches assignmentOperator as a
        && stripCasts(a.targetExpression) matches variableReference as t && varKey(t) == sym);

function isNullLiteral(e : expression) : bool ->
    stripCasts(e) matches nullPointerLiteral
    || stripCasts(e) matches intLiteral { .value == 0 };

// Polarity of a null test of sym inside condition c:
//   1  the true side is the non-null side  (if (p), if (p != 0), if (p && ...))
//  -1  the true side is the null side      (if (!p), if (p == 0))
//   0  c does not test sym
function nullTest(c : astnode, sym : string) : int ->
    switch (c) {
      | binaryOperator { .operator == `&&` } as b ->
            let l = nullTest(b.lhsExpression, sym) in
            if l != 0 then l else nullTest(b.rhsExpression, sym) endif
      | binaryOperator { .operator == `||` } as b ->
            let l = nullTest(b.lhsExpression, sym) in
            if l != 0 then l else nullTest(b.rhsExpression, sym) endif
      | binaryOperator { .operator == `!=` } as b ->
            if (refsVar(b.lhsExpression, sym) && isNullLiteral(b.rhsExpression))
               || (refsVar(b.rhsExpression, sym) && isNullLiteral(b.lhsExpression))
            then 1 else 0 endif
      | binaryOperator { .operator == `==` } as b ->
            if (refsVar(b.lhsExpression, sym) && isNullLiteral(b.rhsExpression))
               || (refsVar(b.rhsExpression, sym) && isNullLiteral(b.lhsExpression))
            then -1 else 0 endif
      | unaryOperator { .operator == `!` } as u ->
            if refsVar(u.operandExpression, sym) then -1
            else 0 - nullTest(u.operandExpression, sym) endif
      | expression as ce -> if refsVar(ce, sym) then 1 else 0 endif
      | default -> 0
    };

// The key of the variable a dereference expression dereferences, or null.
// `p[i]` on a POINTER is spelled as a dereference of `p + i` (only a true
// array keeps subscriptReference), so a dereference of `p +/- i` counts as
// a dereference of p.
function derefTarget(d : astnode) : string? ->
    switch (d) {
      | pointerDereference as p ->
            if stripCasts(p.pointerExpression) matches binaryOperator as b && (b.operator == `+` || b.operator == `-`)
            then (varKey(stripCasts(b.lhsExpression)) ?? varKey(stripCasts(b.rhsExpression)))
            else varKey(stripCasts(p.pointerExpression)) endif
      | memberReference as m ->
            if stripCasts(m.objectExpression) matches pointerDereference as pd
            then varKey(stripCasts(pd.pointerExpression))
            else varKey(stripCasts(m.objectExpression)) endif
      | subscriptReference as s -> varKey(stripCasts(s.arrayExpression))
      | default -> null
    };

// The top of the tree a node sits in: the function definition that owns it.
// (outermostOwner(blockStatement, ...) returns null for expressions; walking
// .parent does not.)
function root(n : astnode) : astnode ->
    if n.parent matches NonNull as p then root(p) else n endif;

function inside(d : astnode, s : astnode) : bool ->
    contains(function(x : astnode) -> x == d, s);

// Does the statement leave the function or the enclosing loop/switch?
function escapes(s : astnode) : bool ->
    contains(function(x : astnode) -> x matches returnStatement || x matches gotoStatement
                                      || x matches breakStatement || x matches continueStatement, s);

// Is dereference d of sym guarded by some test of sym around it?
// (each exists parenthesized: an unparenthesized `exists .. where P || exists ..`
// nests the second inside the first's where, and an empty first collection
// makes the whole disjunction false)
function guarded(d : astnode, sym : string, fn : astnode) : bool ->
       (exists s in allMatchingCodeIn(ifStatement, fn)
            where nullTest(s.conditionExpression, sym) != 0 && inside(d, s))
    // `if (!p) return;` guards everything that follows it (order unknown, so
    // it is taken to guard every dereference outside itself)
    || (exists g in allMatchingCodeIn(ifStatement, fn)
            where nullTest(g.conditionExpression, sym) < 0 && escapes(g.trueStatement) && !inside(d, g))
    || (exists t in allMatchingCodeIn(conditionalOperator, fn)
            where nullTest(t.conditionExpression, sym) != 0 && inside(d, t))
    // a while / for whose condition tests p guards its body (a do-while
    // does not: the body runs before the first test)
    || (exists w in allMatchingCodeIn(whileLoop, fn)
            where nullTest(w.conditionExpression, sym) != 0 && inside(d, w))
    || (exists f in allMatchingCodeIn(forLoopSimple, fn)
            where nullTest(f.conditionExpression, sym) != 0 && inside(d, f))
    || (exists a in allMatchingCodeIn(binaryOperator { .operator == `&&` }, fn)
            where nullTest(a.lhsExpression, sym) > 0 && inside(d, a.rhsExpression))
    || (exists o in allMatchingCodeIn(binaryOperator { .operator == `||` }, fn)
            where nullTest(o.lhsExpression, sym) < 0 && inside(d, o.rhsExpression));

checker {
    name = "PATHOUT_CANDIDATE_NULL_CHECK_THEN_DEREF";
    reports = for d in globalset allFunctionCode
        where derefTarget(d) matches NonNull as sym
           && let fn = root(d) in
              // the function tests sym against null somewhere ...
              exists s in allMatchingCodeIn(ifStatement, fn)
                  where nullTest(s.conditionExpression, sym) != 0
              // ... and nothing guards this dereference of it
              && !guarded(d, sym, fn)
        : {
            events = [
                {
                    description = "Candidate: " + sym.formattedAsCode
                                  + " is null-tested in this function and dereferenced here, unguarded."
                                  + " Path-insensitive; read it, then confirm or refute by fuzzing.";
                    location = d.location;
                }
            ];
        };
};
