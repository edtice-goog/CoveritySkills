// Path-INSENSITIVE shape for NULL_RETURNS: a local receives the result of a
// function that is documented to return null on failure (malloc, fopen,
// getenv, strchr, ...), is dereferenced somewhere in the same function, and
// is never null-tested anywhere in it -- not in an if, a ternary, a loop
// condition, a return, or an && / || operand. Reported once, at the
// assignment. Order-blind: a dereference that precedes the assignment (of a
// previous value) lands here too; that is what reading is for. Project
// wrappers that never return null (xmalloc) are not in the list and so are
// not candidates.
include `C/C++`;

function varKey(r : astnode) : string? ->
    if r matches variableReference as v then (v.mangledName ?? v.identifier) else null endif;

// After casts, is e a reference to sym -- or an assignment to it, so that
// `while ((p = f()) != NULL)` and `if ((p = f()))` count as tests of p.
function refsVar(e : expression, sym : string) : bool ->
       (stripCasts(e) matches variableReference as r && varKey(r) == sym)
    || (stripCasts(e) matches assignmentOperator as a
        && stripCasts(a.targetExpression) matches variableReference as t && varKey(t) == sym);

function isNullLiteral(e : expression) : bool ->
    stripCasts(e) matches nullPointerLiteral || stripCasts(e) matches intLiteral { .value == 0 };

function nullTest(c : astnode, sym : string) : int ->
    switch (c) {
      | binaryOperator { .operator == `&&` } as b ->
            let l = nullTest(b.lhsExpression, sym) in if l != 0 then l else nullTest(b.rhsExpression, sym) endif
      | binaryOperator { .operator == `||` } as b ->
            let l = nullTest(b.lhsExpression, sym) in if l != 0 then l else nullTest(b.rhsExpression, sym) endif
      | binaryOperator { .operator == `!=` } as b ->
            if (refsVar(b.lhsExpression, sym) && isNullLiteral(b.rhsExpression))
               || (refsVar(b.rhsExpression, sym) && isNullLiteral(b.lhsExpression)) then 1 else 0 endif
      | binaryOperator { .operator == `==` } as b ->
            if (refsVar(b.lhsExpression, sym) && isNullLiteral(b.rhsExpression))
               || (refsVar(b.rhsExpression, sym) && isNullLiteral(b.lhsExpression)) then -1 else 0 endif
      | unaryOperator { .operator == `!` } as u ->
            if refsVar(u.operandExpression, sym) then -1 else 0 - nullTest(u.operandExpression, sym) endif
      | expression as ce -> if refsVar(ce, sym) then 1 else 0 endif
      | default -> 0
    };

// `p[i]` on a POINTER is spelled as a dereference of `p + i` (only a true
// array keeps subscriptReference), so a dereference of `p +/- i` counts as
// a dereference of p.
function derefTarget(d : astnode) : string? ->
    switch (d) {
      | pointerDereference as p ->
            if stripCasts(p.pointerExpression) matches binaryOperator as b && (b.operator == `+` || b.operator == `-`)
            then (varKey(stripCasts(b.lhsExpression)) ?? varKey(stripCasts(b.rhsExpression)))
            else varKey(stripCasts(p.pointerExpression)) endif
      | memberReference as m ->
            if stripCasts(m.objectExpression) matches pointerDereference as pd
            then varKey(stripCasts(pd.pointerExpression)) else null endif
      | subscriptReference as s -> varKey(stripCasts(s.arrayExpression))
      | default -> null
    };

function mayReturnNull(name : string) : bool ->
    name == "malloc" || name == "calloc" || name == "realloc" || name == "strdup" || name == "strndup"
    || name == "fopen" || name == "fdopen" || name == "freopen" || name == "tmpfile" || name == "opendir" || name == "readdir"
    || name == "getenv" || name == "strchr" || name == "strrchr" || name == "strstr" || name == "memchr" || name == "strtok"
    || name == "strpbrk" || name == "fgets" || name == "dlopen" || name == "dlsym" || name == "localtime" || name == "gmtime"
    || name == "getpwnam" || name == "getpwuid" || name == "gethostbyname" || name == "getcwd";

function nullCallName(e : expression) : string? ->
    if stripCasts(e) matches functionCall as call
       && call.calledFunction.identifier matches NonNull as nm && mayReturnNull(nm)
    then nm else null endif;

// (local key) for `p = f(..)` or `T *p = f(..)` with f in the list
function nullSource(s : astnode) : string? ->
    switch (s) {
      | assignmentOperator as asg ->
            if asg.targetExpression matches variableReference as dst && dst.scope == `local`
               && nullCallName(asg.sourceExpression) matches NonNull
            then varKey(dst) else null endif
      | variableDeclaration as decl ->
            if decl.initializer matches expressionInitializer as ini && nullCallName(ini.expression) matches NonNull
            then (decl.variable.mangledName ?? decl.variable.identifier) else null endif
      | default -> null
    };

function sourceName(s : astnode) : string ->
    switch (s) {
      | assignmentOperator as asg -> nullCallName(asg.sourceExpression) ?? "?"
      | variableDeclaration as decl ->
            if decl.initializer matches expressionInitializer as ini then (nullCallName(ini.expression) ?? "?") else "?" endif
      | default -> "?"
    };

function root(n : astnode) : astnode ->
    if n.parent matches NonNull as p then root(p) else n endif;

// any test of sym in a condition position anywhere in the function.
// Every `exists` is parenthesized: `exists a in X where P || exists b in Y
// where Q` parses as ONE exists with the second nested in its where, so an
// empty X would make the whole disjunction false.
function everTested(sym : string, fn : astnode) : bool ->
       (exists s in allMatchingCodeIn(ifStatement, fn) where nullTest(s.conditionExpression, sym) != 0)
    || (exists t in allMatchingCodeIn(conditionalOperator, fn) where nullTest(t.conditionExpression, sym) != 0)
    // loop conditions and asserts: any `p == 0` / `p != 0` / `!p` anywhere
    || (exists b in allMatchingCodeIn(binaryOperator, fn)
            where (b.operator == `==` || b.operator == `!=`) && nullTest(b, sym) != 0)
    || (exists u in allMatchingCodeIn(unaryOperator { .operator == `!` }, fn)
            where refsVar(u.operandExpression, sym))
    || (exists a in allMatchingCodeIn(binaryOperator { .operator == `&&` }, fn)
            where nullTest(a.lhsExpression, sym) != 0 || nullTest(a.rhsExpression, sym) != 0)
    || (exists o in allMatchingCodeIn(binaryOperator { .operator == `||` }, fn)
            where nullTest(o.lhsExpression, sym) != 0 || nullTest(o.rhsExpression, sym) != 0)
    || (exists r in allMatchingCodeIn(returnStatement, fn)
            where r.returnedExpression matches NonNull as e && nullTest(e, sym) != 0);

// (allMatchingCodeIn wants a concrete pattern; `expression` enumerates nothing)
function everDereferenced(sym : string, fn : astnode) : bool ->
       (exists d in allMatchingCodeIn(pointerDereference, fn) where derefTarget(d) == sym)
    || (exists m in allMatchingCodeIn(memberReference, fn) where derefTarget(m) == sym)
    || (exists s in allMatchingCodeIn(subscriptReference, fn) where derefTarget(s) == sym);

checker {
    name = "PATHOUT_CANDIDATE_UNCHECKED_NULL_RETURN_DEREF";
    reports = for s in globalset allFunctionCode
        where nullSource(s) matches NonNull as sym
           && let fn = root(s) in everDereferenced(sym, fn) && !everTested(sym, fn)
        : { events = [ { description = "Candidate: " + sym.formattedAsCode + " receives " + sourceName(s).formattedAsCode
                                       + "() here, is dereferenced in this function, and is never null-tested in it."
                                       + " Path-insensitive; read it, then confirm or refute.";
                         location = s.location; } ]; };
};
