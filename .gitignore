# Eval workspace: run outputs, Coverity intermediate directories (large), feedback
coverity-defect-detectability-workspace/
# Coverity intermediate dirs anywhere
idir*/
*.o

__pycache__/
*.pyc

# Demo-data workspace: build trees, idirs, DB backups (large)
coverity-demo-data-workspace/

# Issue-transition workspace: build trees, idirs, snapshots (large)
coverity-issue-transition-inference-workspace/

# Reproductions built from customer material never enter the repo
# (see CONTRIBUTING.md). Keep them beside the checkout, not in it.
pathout-cpp-repro/
*-repro/

# Checker-selection workspace: measured checker data, idirs, customer runs
coverity-checker-selection-workspace/

# Site configuration: staging root and archive host. Never committed.
archive-target.local
